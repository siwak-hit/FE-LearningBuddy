---
import Modal from '../common/Modal.astro';
import SourcePdfHighlighter from '../source/SourcePdfHighlighter.jsx';
const { API_BASE } = Astro.props;
---

<style is:global>
  /* FIX: Class untuk menutup sidebar secara mulus di desktop */
  @media (min-width: 768px) {
    .desktop-collapsed {
      width: 0 !important;
      min-width: 0 !important;
      max-width: 0 !important;
      opacity: 0 !important;
      border-right-width: 0 !important;
      overflow: hidden !important;
    }
  }

  /* Panduan Cepat: section accordion + tombol seragam + hover geser & redupkan tetangga */
  .guide-section > summary { list-style: none; cursor: pointer; }
  .guide-section > summary::-webkit-details-marker { display: none; }
  .guide-section[open] > summary .guide-sec-chev { transform: rotate(180deg); }
  .guide-section-list:hover .guide-btn { opacity: 0.5; }
  .guide-section-list .guide-btn:hover { opacity: 1; transform: translateX(4px); cursor: pointer; }

  /* Tombol kirim tampak abu-abu (disabled) saat input kosong — murni CSS via :placeholder-shown */
  #chat-form:has(#chat-input:placeholder-shown) #btn-send { filter: grayscale(1) opacity(0.5); pointer-events: none; }

  /* ============================================================
     Konfigurasi tampilan (modal tombol gear di header).
     Default = tampilan ringkas; tiap switch menambah body-class.
     Sumber kebenaran state ada di workspace-config.js.
     ============================================================ */
  body:not(.alb-cfg-tabs) #sidebar-tabs { display: none !important; }

  body:not(.alb-cfg-adv) #alb-global-ai-usage-wrap,
  body:not(.alb-cfg-adv) #btn-session-info,
  body:not(.alb-cfg-adv) [id^="alb-intent-"],
  body:not(.alb-cfg-adv) div:has(> .btn-user-copy),
  body:not(.alb-cfg-adv) div:has(> .btn-bot-copy) { display: none !important; }

  /* Hapus chat/sesi sekarang tinggal di modal konfigurasi. */
  #alb-delete-session-btn { display: none !important; }

  body.alb-cfg-popup-off #alb-reminder-toast-host { display: none !important; }
  body.alb-cfg-suggest-off #suggestion-wrapper { display: none !important; }

  body:not(.alb-cfg-guide) #tab-content-guide [data-alb-feature="guide"],
  body:not(.alb-cfg-class-data) #tab-content-guide [data-alb-feature="class_data"],
  body:not(.alb-cfg-notes) #tab-content-guide [data-alb-notes-menu="1"],
  body:not(.alb-cfg-complaint) #tab-content-guide [data-alb-complaint-menu="1"] { display: none !important; }
</style>

<div class="h-screen flex bg-canvas overflow-hidden font-sans relative w-full">

  <div
    id="context-backdrop"
    class="hidden md:hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-30 opacity-0 transition-opacity duration-300"
  ></div>

  <aside
    id="context-sidebar"
    class="fixed md:relative inset-y-0 left-0 z-40 w-[86%] max-w-[380px] md:w-[320px] lg:w-[380px] shrink-0 h-full bg-canvas-soft border-r border-hairline flex flex-col transform -translate-x-full md:translate-x-0 transition-all duration-300 ease-out overflow-hidden"
  >

  <!-- [config] Baris header sidebar tinggal berisi tombol tutup (mobile) karena tombol
       "Kembali ke VClass" di-hide — di desktop barisnya ikut dibuang supaya konten
       sidebar naik ke atas, tidak menyisakan area kosong setinggi h-20. -->
  <div class="md:hidden h-20 px-6 border-b border-hairline shrink-0 flex items-center justify-end w-full">
    <button id="btn-back" class="hidden text-muted hover:text-ink items-center text-[15px] font-medium transition-colors">
      <i class="fa-solid fa-arrow-left mr-2"></i> Kembali ke VClass
    </button>

    <button
      id="btn-close-context"
      type="button"
      class="md:hidden w-9 h-9 rounded-full bg-surface-card border border-hairline flex items-center justify-center text-muted hover:text-ink transition-colors"
    >
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- Switch button (segmented), lebih mencolok dari tab underline -->
  <div id="sidebar-tabs" class="px-5 md:px-6 py-3 shrink-0">
    <div class="flex gap-1 bg-canvas-soft border border-hairline rounded-full p-1">
      <button id="tab-btn-guide" type="button" class="flex-1 py-2 text-[13px] font-semibold rounded-full transition-colors outline-none bg-ink text-white shadow-sm">Panduan Cepat</button>
      <button id="tab-btn-elements" type="button" class="flex-1 py-2 text-[13px] font-semibold rounded-full transition-colors outline-none text-muted">Elemen Halaman</button>
    </div>
  </div>

  <div id="tab-content-guide" class="flex-1 overflow-y-auto p-5 md:p-6 w-full md:w-[320px] lg:w-[380px]">

    <details data-alb-feature="guide" class="guide-section pb-4 mb-4 border-b border-hairline" open>
      <summary class="flex items-center justify-between gap-2 mb-3">
        <span class="text-[12px] font-semibold text-muted uppercase tracking-[0.96px]">Panduan Penggunaan</span>
        <i class="fa-solid fa-chevron-down guide-sec-chev text-[11px] text-muted-soft transition-transform"></i>
      </summary>
      <div class="guide-section-list space-y-2">
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="tutorial_buat_forum" data-msg="Cara membuat forum diskusi di VClass">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-pen-to-square text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cara Buat Forum Diskusi</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="tutorial_reply_forum" data-msg="Cara reply atau balas diskusi forum di VClass">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-comments text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cara Reply/Balas Diskusi</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="tutorial_kumpulin_tugas" data-msg="Cara mengumpulkan tugas di VClass">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-cloud-arrow-up text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cara Mengumpulkan Tugas</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="tutorial_kuis" data-msg="Cara mengerjakan kuis di VClass">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-clipboard-question text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cara Mengerjakan Kuis</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="tutorial_logout" data-msg="Cara logout dari VClass">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-right-from-bracket text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cara Logout</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="tutorial_lihat_aktivitas" data-msg="Cara melihat aktivitas di VClass">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-list-check text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cara Melihat Aktivitas</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="tutorial_lihat_nilai" data-msg="Cara melihat nilai di VClass">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-chart-simple text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cara Melihat Nilai</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
      </div>
    </details>

    <details data-alb-feature="class_data" class="guide-section pb-4 mb-4 border-b border-hairline" open>
      <summary class="flex items-center justify-between gap-2 mb-3">
        <span class="text-[12px] font-semibold text-muted uppercase tracking-[0.96px]">Data Kelas &amp; Tugas</span>
        <i class="fa-solid fa-chevron-down guide-sec-chev text-[11px] text-muted-soft transition-transform"></i>
      </summary>
      <div class="guide-section-list space-y-2">
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="cek_tugas_belum_selesai" data-msg="Tugas apa saja yang belum saya selesaikan?">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-file-signature text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cek Tugas Belum Selesai</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="cek_deadline_hari_ini" data-msg="Ada deadline apa saja hari ini?">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-clock text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cek Deadline Hari ini</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="cek_quiz_belum_dikerjakan" data-msg="Quiz apa yang belum saya kerjakan?">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-list-check text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cek Kuis Belum Dikerjakan</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="cek_forum_belum_dijawab" data-msg="Forum apa yang belum saya jawab?">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-comments text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Cek Forum Belum Dijawab</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
        <button type="button" class="guide-btn btn-fast-guide w-full flex items-center gap-3 bg-surface-card border border-hairline rounded-xl px-3 py-2.5 text-[13px] font-medium text-ink transition-all duration-200" data-intent="cek_pengajar_course" data-msg="Siapa pengajar course Informatika saya?">
          <span class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center shrink-0"><i class="fa-solid fa-chalkboard-user text-[13px]"></i></span>
          <span class="flex-1 text-left truncate">Info Pengajar Kelas</span>
          <i class="fa-solid fa-chevron-right text-muted-soft text-[11px] shrink-0"></i>
        </button>
      </div>
    </details>

    <button type="button" data-alb-feature="contact_teacher" class="btn-fast-guide w-full flex items-center gap-3 bg-emerald-50/60 hover:bg-emerald-100/80 border border-emerald-200/80 rounded-xl px-3 py-2.5 text-[13px] font-semibold text-emerald-800 transition-colors" data-intent="hubungi_guru" data-msg="Hubungi Guru">
      <span class="w-8 h-8 rounded-lg bg-green-600 text-white flex items-center justify-center shrink-0"><i class="fa-brands fa-whatsapp text-[15px]"></i></span>
      <span class="flex-1 text-left">Hubungi Guru (WhatsApp)</span>
    </button>
  </div>

  <div id="tab-content-elements" class="hidden flex-1 overflow-y-auto p-5 md:p-6 w-full md:w-[320px] lg:w-[380px]">
    <!-- Preview konteks ringkas: baris 1 (judul + menu titik-3 + chevron), baris 2 (deskripsi) -->
    <div class="mb-4 pb-4 border-b border-hairline">
      <div class="flex items-center gap-2">
        <h2 id="context-title" class="font-serif font-light text-xl md:text-2xl text-ink leading-tight tracking-tight truncate flex-1 min-w-0" title="Klik ikon info untuk judul lengkap">Memuat Halaman...</h2>
        <div class="flex items-center gap-1.5 shrink-0">
          <div class="relative shrink-0">
            <button id="ctx-menu-toggle" type="button" class="w-7 h-7 rounded-full border border-hairline text-muted hover:text-ink flex items-center justify-center transition-colors" title="Opsi konteks">
              <i class="fa-solid fa-ellipsis-vertical text-[13px]"></i>
            </button>
            <div id="ctx-menu" class="hidden absolute right-0 top-9 z-50 bg-surface-card border border-hairline rounded-xl shadow-lg p-2 min-w-[170px] flex flex-col gap-1.5">
              <span id="manual-context-anchor" class="block"></span>
              <button id="btn-context-info" type="button" class="w-full text-left px-2 py-1.5 rounded-lg text-[13px] text-ink hover:bg-surface-strong flex items-center gap-2 transition-colors">
                <i class="fa-solid fa-circle-info text-[13px] text-muted"></i> Info lengkap halaman
              </button>
            </div>
          </div>
          <button id="ctx-preview-toggle" type="button" class="shrink-0 w-7 h-7 rounded-full border border-hairline text-muted hover:text-ink flex items-center justify-center transition-colors" title="Perbesar / ringkas preview">
            <i id="ctx-preview-chevron" class="fa-solid fa-chevron-down text-[11px] transition-transform"></i>
          </button>
        </div>
      </div>
      <p id="context-desc" class="text-[13px] text-muted-soft leading-snug line-clamp-1 mt-1.5">Pilih elemen di bawah ini yang ingin kamu tanyakan fungsinya.</p>
    </div>
    <div id="element-list" class="space-y-3"></div>
  </div>
  </aside>

  <main class="flex-1 h-full flex flex-col bg-canvas relative min-w-0 transition-all duration-300">
    <div id="onboarding-modal" class="hidden absolute inset-0 bg-canvas/95 backdrop-blur-md z-50 flex flex-col items-center justify-center p-6 text-center">
      <div id="onboarding-slides" class="max-w-md w-full relative">
        </div>
    </div>

    <header class="h-20 border-b border-hairline flex items-center justify-between px-4 md:px-8 shrink-0 bg-surface-card z-10">
      <div class="flex items-center gap-3 min-w-0">
        <button
          id="btn-open-context"
          type="button"
          class="w-10 h-10 rounded-full bg-surface-strong border border-hairline flex items-center justify-center text-ink shrink-0 hover:bg-hairline-strong transition-colors"
        >
          <i class="fa-solid fa-bars"></i>
        </button>

        <div class="min-w-0">
          <div class="flex items-center gap-1.5 min-w-0">
            <h1 id="chat-title" class="font-medium text-ink text-[16px] truncate">AI Learning Buddy</h1>
            <!-- [#3] Ikon edit identitas: muncul saat siswa melewati form nama; klik untuk pilih ulang. -->
            <button id="btn-edit-identity" type="button" class="hidden shrink-0 w-6 h-6 rounded-full border border-hairline text-muted hover:text-primary hover:border-primary flex items-center justify-center transition-colors" title="Ubah / pilih ulang namamu">
              <i class="fa-solid fa-pen text-[10px]"></i>
            </button>
          </div>
          <p id="chat-subtitle" class="text-[14px] text-muted truncate">Asisten Belajar Virtual</p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button id="btn-session-info" class="bg-surface-card border border-hairline text-[12px] font-semibold uppercase tracking-wider text-ink px-4 py-2 rounded-full hover:bg-surface-strong transition-colors shrink-0">
          Sesi: <span id="chat-count">0</span>/3
        </button>

        <button
          id="btn-workspace-config"
          type="button"
          title="Konfigurasi tampilan"
          class="w-10 h-10 rounded-full bg-surface-card border border-hairline text-ink hover:bg-surface-strong transition-colors flex items-center justify-center shrink-0"
        >
          <i class="fa-solid fa-gear"></i>
        </button>
      </div>
    </header>

    <div id="chat-area" class="flex-1 overflow-y-auto p-4 md:p-8 space-y-8 bg-canvas">
      <div class="flex items-start gap-3 md:gap-4">
        <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center shrink-0 text-[15px] shadow-sm">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="bg-surface-card border border-hairline rounded-2xl rounded-tl-none p-4 md:p-5 max-w-[85%] text-[15px] text-body leading-relaxed">
          Halo! Aku sudah membaca halaman <b><span id="welcome-context-title"></span></b>. Ada bagian materi yang ingin didiskusikan?
        </div>
      </div>
    </div>

    <button id="btn-scroll-bottom" type="button" class="hidden absolute bottom-28 md:bottom-32 right-4 md:right-8 z-20 w-10 h-10 rounded-full bg-surface-card border border-hairline-strong shadow-lg text-ink hover:bg-surface-strong transition-colors flex items-center justify-center" title="Ke pesan terbaru">
      <i class="fa-solid fa-arrow-down text-[14px]"></i>
    </button>

    <div class="shrink-0 p-3 md:p-4 lg:p-5 bg-gradient-to-t from-canvas via-canvas to-transparent border-t border-hairline/50">
      <div id="selected-bar" class="hidden items-center justify-between bg-surface-strong border border-hairline-strong rounded-xl px-4 py-2.5 mb-2 shadow-sm">
        <div class="text-[14px] text-ink font-medium truncate flex-1" id="selected-text">@element dipilih</div>
        <button id="btn-clear-selected" type="button" class="text-muted hover:text-semantic-error ml-4 px-1 transition-colors">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div id="suggestion-wrapper" class="pb-2 transition-all duration-300">
        <div class="flex gap-2 overflow-x-auto no-scrollbar" id="suggestion-chips"></div>
      </div>

      <form id="chat-form" class="flex items-center gap-2 md:gap-3 relative bg-surface-card border border-hairline-strong rounded-[24px] p-2 shadow-sm focus-within:border-ink transition-colors">
        <!-- [v0.9.23] Bungkus input: di MOBILE chip mention menumpuk di ATAS input (kolom),
             di desktop tetap sebaris. Input tak lagi terdesak sempit oleh chip. -->
        <div id="chat-input-wrap" class="flex-1 min-w-0 flex flex-col md:flex-row md:items-center gap-1 md:gap-0">
          <input
            type="text"
            id="chat-input"
            placeholder="Tanya sesuatu atau pilih elemen..."
            class="w-full md:flex-1 bg-transparent px-4 md:px-5 py-2 text-[15px] text-ink focus:outline-none min-w-0"
            autocomplete="off"
          >
        </div>

        <div class="relative flex items-center select-none" id="response-mode-dropdown">
          <button
            type="button"
            id="btn-mode-dropdown-toggle"
            class="h-10 px-2.5 md:px-3 rounded-xl border border-hairline bg-surface-strong text-[12px] font-bold text-ink hover:bg-hairline-strong transition-colors flex items-center gap-1.5 whitespace-nowrap outline-none"
            title="Pilih mode jawaban"
          >
            <i class="fa-solid fa-sliders text-muted"></i>
            <span id="current-mode-label" class="hidden md:inline">Jawaban Sistem</span>
            <i class="fa-solid fa-chevron-up text-[9px] text-muted-soft hidden md:inline"></i>
          </button>

          <div
            id="response-mode-menu"
            class="hidden absolute bottom-14 right-0 z-50 min-w-[190px] bg-white border border-hairline rounded-xl shadow-xl p-1 flex flex-col gap-0.5 animate-in fade-in slide-in-from-bottom-2 duration-150"
          >
            <button
              type="button"
              class="opt-response-mode w-full text-left px-3 py-2 text-[13px] font-semibold rounded-lg hover:bg-surface-strong transition-colors text-primary border-0 bg-transparent cursor-pointer"
              data-mode="system"
            >
              <i class="fa-solid fa-gear mr-2 text-[12px] text-slate-500"></i>
              Jawaban Sistem
            </button>

            <button
              type="button"
              class="opt-response-mode w-full text-left px-3 py-2 text-[13px] font-semibold rounded-lg hover:bg-surface-strong transition-colors text-ink border-0 bg-transparent cursor-pointer"
              data-mode="ai_short"
            >
              <i class="fa-solid fa-wand-magic-sparkles mr-2 text-[12px] text-sky-500"></i>
              Jawaban AI
            </button>
          </div>
        </div>

        <button
          type="submit"
          id="btn-send"
          class="w-12 h-12 shrink-0 bg-primary text-white rounded-full flex items-center justify-center hover:bg-primary-active transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <i class="fa-solid fa-arrow-up"></i>
        </button>
      </form>
    </div>

    <div id="cooldown-overlay" class="hidden absolute inset-0 bg-canvas/90 backdrop-blur-md flex flex-col items-center justify-center z-20">
      <div class="text-ink text-3xl mb-4"><i class="fa-solid fa-hourglass-half fa-spin"></i></div>
      <div class="font-serif font-light text-3xl text-ink mb-2">Batas Sesi Tercapai</div>
      <div class="text-[15px] text-muted mb-8">Mohon tunggu <span id="timer-display" class="font-semibold text-ink">03:00</span> untuk melanjutkan.</div>
      <button id="btn-reload" class="hidden bg-primary text-white rounded-full px-8 py-3 text-[15px] font-medium hover:bg-primary-active transition-colors shadow-sm">
        Muat Ulang Halaman
      </button>
    </div>

    <!-- [FIX] Overlay lockdown TUNGGAL dibuat dinamis di safety-overlays.js
         (#alb-global-lock-overlay: nama ter-prefill + tombol WA + verifikasi key).
         Overlay statik lama dihapus karena dulu tampil bertumpuk → bikin field nama
         kosong & tombol minta nama padahal nama sudah ada. -->
  </main>
</div>

<Modal id="modal-session-info" title="Informasi Sesi">
  <div class="text-body text-[15px] leading-relaxed">
    <p class="mb-4">Mode external dibatasi maksimal <b class="text-ink">3 dialog berurut</b>.</p>
    <p>Jika lebih dari itu, percakapan akan dijeda selama 3 menit agar server tetap ringan dan responsif.</p>
  </div>
  <div class="mt-8 flex justify-end">
    <button type="button" class="btn-close-modal bg-primary text-white rounded-full px-6 py-2.5 text-[15px] font-medium hover:bg-primary-active transition-colors">Saya Mengerti</button>
  </div>
</Modal>

<Modal id="modal-confirm-back" title="Tinggalkan Percakapan?">
  <div class="text-body text-[15px] leading-relaxed">
    <p>Jika Anda keluar dari halaman AI, log percakapan ini akan <b class="text-ink">hilang</b>.</p>
    <p class="mt-4 text-[14px] p-4 bg-surface-strong border border-hairline rounded-xl">
      💡 <b>Tips:</b> Disarankan kembali ke tab VClass sebelumnya, lalu pindah halaman di sana dan klik tombol AI lagi.
    </p>
  </div>
  <div class="mt-8 flex flex-col sm:flex-row gap-3">
    <button type="button" class="btn-close-modal flex-1 border border-hairline-strong text-ink rounded-full py-2.5 text-[15px] font-medium hover:bg-surface-strong transition-colors">Tetap di sini</button>
    <button type="button" id="btn-confirm-leave" class="flex-1 bg-semantic-error text-white rounded-full py-2.5 text-[15px] font-medium hover:bg-red-700 transition-colors">Keluar ke VClass</button>
  </div>
</Modal>

