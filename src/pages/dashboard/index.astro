---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Modal from '../../components/common/Modal.astro';
---
<DashboardLayout title="Dashboard">
  <style>
    #dash-tabs .dash-tab-btn.is-active {
      border-color: var(--color-ink, #0c0a09);
      color: var(--color-ink, #0c0a09);
      font-weight: 600;
    }
  </style>

  <div class="max-w-[1200px] mx-auto w-full flex flex-col gap-8">
    <!-- Header: judul + sub judul -->
    <header>
      <h1 class="font-serif text-3xl md:text-4xl text-ink tracking-tight mb-2 font-light">Dashboard</h1>
      <p class="text-body text-[16px]">Pilih menu untuk melihat ringkasan statistiknya, lalu buka halaman detail bila perlu.</p>
    </header>

    <!-- Menu dashboard -->
    <div id="dash-tabs" class="flex flex-wrap gap-1 border-b border-hairline">
      <button type="button" class="dash-tab-btn is-active px-4 py-3 -mb-px border-b-2 border-transparent text-[15px] text-muted hover:text-ink transition-colors" data-target="dash-pane-projects">
        <i class="fa-solid fa-folder-open mr-1.5 text-[13px]"></i> Daftar Project
      </button>
      <button type="button" class="dash-tab-btn px-4 py-3 -mb-px border-b-2 border-transparent text-[15px] text-muted hover:text-ink transition-colors" data-target="dash-pane-analytics">
        <i class="fa-solid fa-chart-pie mr-1.5 text-[13px]"></i> Analitik
      </button>
      <button type="button" class="dash-tab-btn px-4 py-3 -mb-px border-b-2 border-transparent text-[15px] text-muted hover:text-ink transition-colors" data-target="dash-pane-logs">
        <i class="fa-solid fa-shield-halved mr-1.5 text-[13px]"></i> Logs Percakapan
      </button>
    </div>

    <!-- Container pembungkus konten menu -->
    <div class="bg-surface-card border border-hairline rounded-2xl p-5 md:p-7 shadow-[0_4px_16px_rgba(0,0,0,0.03)]">
    <!-- PANE: Daftar Project -->
    <section id="dash-pane-projects" class="dash-pane">
      <div class="flex items-center justify-between gap-3 mb-5">
        <h2 class="text-[16px] font-semibold text-ink flex items-center gap-2">
          <i class="fa-solid fa-folder-open text-muted-soft"></i> Project Aktif
        </h2>
        <button id="btn-open-create-modal" class="bg-primary text-white rounded-full px-5 py-2.5 text-[14px] font-medium hover:bg-primary-active transition-colors shadow-sm shrink-0">
          <i class="fa-solid fa-plus mr-1.5"></i> Buat Project
        </button>
      </div>
      <div id="project-list" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
        <div class="col-span-full text-center py-12 text-muted-soft"><i class="fa-solid fa-spinner fa-spin text-2xl"></i><br>Memuat data...</div>
      </div>
    </section>

    <!-- PANE: Analitik -->
    <section id="dash-pane-analytics" class="dash-pane hidden flex flex-col gap-5">
      <div id="dash-analytics-cards" class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="col-span-full text-center py-8 text-muted-soft"><i class="fa-solid fa-spinner fa-spin"></i></div>
      </div>
      <a href="/dashboard/analytics" class="self-start inline-flex items-center gap-2 border border-hairline-strong text-ink text-[14px] font-medium px-5 py-2.5 rounded-full hover:bg-canvas-soft transition-colors">
        Buka Analitik Pembelajaran <i class="fa-solid fa-arrow-right text-[12px]"></i>
      </a>
    </section>

    <!-- PANE: Logs Percakapan -->
    <section id="dash-pane-logs" class="dash-pane hidden flex flex-col gap-5">
      <div id="dash-logs-cards" class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="col-span-full text-center py-8 text-muted-soft"><i class="fa-solid fa-spinner fa-spin"></i></div>
      </div>
      <a href="/dashboard/logs" class="self-start inline-flex items-center gap-2 border border-hairline-strong text-ink text-[14px] font-medium px-5 py-2.5 rounded-full hover:bg-canvas-soft transition-colors">
        Buka Logs Percakapan <i class="fa-solid fa-arrow-right text-[12px]"></i>
      </a>
    </section>
    </div>
  </div>

  <Modal id="modal-create-project" title="Project Baru">
    <form id="form-create-project" class="space-y-6">
      <div>
        <label class="block text-[14px] font-medium text-ink mb-2">Nama Project (Mata Pelajaran)</label>
        <input type="text" id="project_name" class="w-full bg-canvas-soft border border-hairline-strong rounded-[8px] px-4 py-3 text-[15px] text-ink focus:border-ink focus:outline-none" required placeholder="Cth: Informatika Kelas 10">
      </div>
      <button type="submit" class="w-full bg-primary text-white rounded-full py-3 text-[15px] font-medium hover:bg-primary-active transition-colors">
        Buat Project
      </button>
    </form>
  </Modal>
</DashboardLayout>
