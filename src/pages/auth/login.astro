---
import '../../styles/global.css';
---
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login - AI Buddy Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Playfair+Display:wght@300;400&display=swap" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <style>
    .gradient-orb {
      position: absolute; width: 600px; height: 600px;
      background: radial-gradient(circle, #f4c5a8 0%, rgba(245,245,245,0) 70%);
      bottom: -200px; right: -100px; z-index: 0; opacity: 0.5; pointer-events: none;
    }
  </style>
</head>
<body class="bg-canvas text-body font-sans min-h-screen w-full flex flex-col justify-center items-center relative overflow-x-hidden p-4 py-8">

  <div class="gradient-orb"></div>

  <div class="bg-surface-card border border-hairline p-8 md:p-10 rounded-[24px] shadow-sm w-full max-w-md mx-auto relative z-10">
    <div class="text-center mb-8">
      <h1 class="font-serif text-3xl text-ink tracking-tight mb-2"><i class="fa-solid fa-feather-pointed mr-2"></i>AI Buddy</h1>
      <p id="auth-subtitle" class="text-[15px] text-muted-soft">Masuk ke Dashboard Guru</p>
    </div>

    <!-- FORM LOGIN -->
    <form id="login-form" class="space-y-5">
      <div>
        <label class="block text-[14px] font-medium text-ink mb-2">Email</label>
        <input type="email" id="email" class="w-full bg-canvas-soft border border-hairline-strong rounded-[8px] px-4 py-3 text-[15px] text-ink focus:border-ink focus:outline-none transition-colors" placeholder="guru@sekolah.com" required>
      </div>
      <div>
        <label class="block text-[14px] font-medium text-ink mb-2">Password</label>
        <div class="relative">
          <input type="password" id="password" class="w-full bg-canvas-soft border border-hairline-strong rounded-[8px] px-4 pr-11 py-3 text-[15px] text-ink focus:border-ink focus:outline-none transition-colors" placeholder="••••••••" required>
          <button type="button" id="toggle-password" tabindex="-1" aria-label="Tampilkan atau sembunyikan password" class="absolute inset-y-0 right-0 flex items-center px-3.5 text-muted-soft hover:text-ink transition-colors">
            <i class="fa-solid fa-eye" id="toggle-password-icon"></i>
          </button>
        </div>
      </div>
      <button type="submit" class="w-full bg-primary text-white rounded-full py-3 text-[15px] font-medium hover:bg-primary-active transition-colors mt-4">
        Masuk
      </button>
    </form>

    <!-- FORM DAFTAR (tersembunyi awal) -->
    <form id="register-form" class="space-y-5 hidden">
      <div>
        <label class="block text-[14px] font-medium text-ink mb-2">Email</label>
        <input type="email" id="reg-email" class="w-full bg-canvas-soft border border-hairline-strong rounded-[8px] px-4 py-3 text-[15px] text-ink focus:border-ink focus:outline-none transition-colors" placeholder="guru@sekolah.com" required>
      </div>
      <div>
        <label class="block text-[14px] font-medium text-ink mb-2">Password <span class="text-muted-soft font-normal">(min. 6 karakter)</span></label>
        <div class="relative">
          <input type="password" id="reg-password" class="w-full bg-canvas-soft border border-hairline-strong rounded-[8px] px-4 pr-11 py-3 text-[15px] text-ink focus:border-ink focus:outline-none transition-colors" placeholder="••••••••" required>
          <button type="button" id="toggle-reg-password" tabindex="-1" aria-label="Tampilkan atau sembunyikan password" class="absolute inset-y-0 right-0 flex items-center px-3.5 text-muted-soft hover:text-ink transition-colors">
            <i class="fa-solid fa-eye" id="toggle-reg-password-icon"></i>
          </button>
        </div>
      </div>
      <div>
        <label class="block text-[14px] font-medium text-ink mb-2">Kode Registrasi</label>
        <input type="text" id="reg-code" class="w-full bg-canvas-soft border border-hairline-strong rounded-[8px] px-4 py-3 text-[15px] text-ink focus:border-ink focus:outline-none transition-colors" placeholder="Kode dari admin sistem" required>
        <p class="text-[12px] text-muted-soft mt-1.5"><i class="fa-solid fa-shield-halved mr-1"></i> Pendaftaran dibatasi kode rahasia agar hanya guru berwenang yang bisa membuat akun.</p>
      </div>
      <button type="submit" class="w-full bg-primary text-white rounded-full py-3 text-[15px] font-medium hover:bg-primary-active transition-colors mt-4">
        Daftar
      </button>
    </form>

    <!-- Toggle login/daftar -->
    <p class="text-center text-[14px] text-muted-soft mt-6">
      <span id="to-register-wrap">Belum punya akun? <button type="button" id="to-register" class="text-primary font-semibold hover:underline">Daftar di sini</button></span>
      <span id="to-login-wrap" class="hidden">Sudah punya akun? <button type="button" id="to-login" class="text-primary font-semibold hover:underline">Masuk di sini</button></span>
    </p>
  </div>

  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="../../scripts/main.js"></script>
</body>
</html>
